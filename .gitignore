# secrets — never commit
.env
.env.*
!.env.example
secrets/
*.key
*.pem

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# IFRS17 raw filings (large, regenerable from OpenDART)
data/ifrs17/raw/
data/ifrs17/raw_history/
# 300+ CSM JSONs (intermediate, regenerable)
data/ifrs17/extracted_history/
data/ifrs17/reports/

# FSC bond API raw pulls (regenerable via scripts/ingest_fsc_bonds.py)
data/bonds/raw/
# per-stamp raw pulls; keep only data/bonds/normalized/<stamp>
data/bonds/[0-9]*/

# K-ICS disclosure raw PDF + parsed (HUGE — 1.3GB). Keep regenerable from source.
# Only the canonical kics_disclosure.json at root is committed.
data/disclosure/

# Raw DART/IR/KIDI data purged from git history 2026-06-14 (HUGE, regenerable;
# kept on disk untracked. Canonical data/dart/viz/*.json stays tracked.)
data/_archive/
data/dart/**/raw/
data/dart/raw/
data/dart/CORPCODE.xml
data/dart/**/*.zip
data/dart/**/*.xml
data/kidi/
data/ir/**/raw/
# IR factsheet xlsx (third-party IR material — each insurer's own copyrighted
# deck). Untracked 2026-09-11 (artifacts/legal/ip_protection_report_20260911.md
# §6-8): pipeline reads them from disk, never from git. History NOT purged
# (owner decision). Parsed JSON next to them stays tracked.
data/ir/**/*.xlsx

# J-ESR (Japan ESR) pipeline — EDINET subscription key + raw XBRL pulls (HUGE, regenerable)
J-ESR/edinet_key.txt
J-ESR/raw/*
# 단, 추출 중간산출(JSON)은 추적한다 — 원문 PDF 는 무겁고 다시 받으면 되지만, 이 JSON 이
# 없으면 새 클론·클라우드 세션에서 `build_jesr_detail_json.py` 가 아예 못 돈다
# (2026-09-13 실측: FileNotFoundError au_nonlife_...pdf → 수치 수정을 빌더 대신 셀 수술로 해야 했다).
!J-ESR/raw/fy2025_samples/
J-ESR/raw/fy2025_samples/*
!J-ESR/raw/fy2025_samples/*.json

# Large reference / intermediate dirs (regenerable)
artifacts/
md_inbox/

# Forward sim per-stamp outputs are small; keep them (manifests + JSONs)
